# Values used by docker-compose.yml at build/container-creation time.
# Runtime secrets for the backend app itself still live in backend/.env
# (loaded via env_file) — this file only covers what compose needs before
# the backend container even starts (MySQL root password/db name) and what
# gets baked into the frontend image at build time (Cloudinary cloud name).
#
# Copy to .env and fill in — keep it in sync with backend/.env's
# DB_PASSWORD / DB_NAME / CLOUDINARY_CLOUD_NAME.

DB_PASSWORD=your-mysql-password
DB_NAME=ecommerce
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
