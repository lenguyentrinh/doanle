# Values used by docker-compose.yml at build/container-creation time.
# Runtime secrets for the backend app itself still live in backend/.env
# (loaded via env_file) — this file only covers what gets baked into the
# frontend image at build time (Cloudinary cloud name).
#
# MongoDB needs no credentials here: the compose `mongo` service is a
# single-node replica set (rs0) and the backend is pointed at it via
# MONGODB_URI in docker-compose.yml.
#
# Copy to .env and fill in — keep CLOUDINARY_CLOUD_NAME in sync with
# backend/.env.

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
