# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
DB_NAME=ecommerce

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Swagger (/api docs) is on by default outside production. In production it
# is off unless explicitly enabled here — the schema exposes every route and
# DTO shape, so turning it on in production should be a deliberate choice.
ENABLE_SWAGGER=false

# Number of reverse-proxy hops (Nginx, load balancer, CDN, ...) in front of
# this server. Must match the real deployment topology exactly: too high lets
# a client spoof its IP via X-Forwarded-For and dodge rate limiting; too low
# rate-limits by the proxy's IP instead of the real client's. Set to 0 if the
# backend is reached directly (e.g. local dev) with no proxy in between.
TRUST_PROXY_HOPS=1

# Product image base URL — prepended to bare (non-Cloudinary) stored image
# keys at read time, i.e. seed-data placeholder filenames like
# "product-placeholder.svg". Points at the frontend's local placeholder folder.
PRODUCT_IMAGE_BASE_URL=/images/placeholders

# VESTIGIAL, not read by the app: StorageService.resolveUrl() now resolves
# every slash-containing (admin-uploaded) image key via the Cloudinary SDK
# instead (see CLOUDINARY_* below), with no way to distinguish a pre-migration
# local-disk key from a real Cloudinary key — both look like "products/<id>".
# Any product image uploaded before this migration will 404 until an admin
# re-uploads it via the admin UI (accepted one-time cost; no automated
# backfill was built for this one-row-of-test-data case). This var and the
# local-disk /uploads static mount it used to pair with are left in place only
# for reference/rollback, not because any code path still uses them.
PRODUCT_UPLOADS_BASE_URL=http://localhost:3001/uploads

# Cloudinary credentials — consumed by StorageService (cloudinary.config()) to
# upload/remove/resolve admin product images. Configured from these three
# discrete vars; CLOUDINARY_URL below is unused scaffolding — its `${VAR}`
# interpolation is never expanded because this app's ConfigModule.forRoot()
# does not set `expandVariables: true`, so it would be read as a literal
# broken string if anything tried to consume it.
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_URL=cloudinary://${CLOUDINARY_API_KEY}:${CLOUDINARY_API_SECRET}@${CLOUDINARY_CLOUD_NAME}

# Email (SMTP) — optional; leave SMTP_* unset to run with email disabled
# (in production, missing SMTP_* makes startup fail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Sender address for transactional email (falls back to SMTP_USER).
MAIL_FROM=noreply@ecommerce.com

# AWS S3 Configuration (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Payment: MVP uses an in-app mock gateway (Story 4.1a) — no external provider,
# no Stripe keys, no webhook secret.

# Admin dashboard: products at or below this stock quantity count as
# "low stock" (Story 5.1). Defaults to 5 when unset or unparseable.
LOW_STOCK_THRESHOLD=5
