# Kafka broker(s), comma-separated — must be reachable from wherever this
# process runs. Topic names are the event patterns themselves (mail.otp,
# mail.order_confirmation, mail.order_status_update, mail.health_check),
# hardcoded in src/main.ts's consumer / mail.controller.ts's handlers.
KAFKA_BROKERS=localhost:9092

NODE_ENV=development

# Email Configuration (optional — leave unset to run with email disabled,
# same "log-only stub" behavior the monolith had before this service split)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Order/transactional email sender.
MAIL_FROM=noreply@ecommerce.com

# Used to build the "track your order" link in confirmation/status emails.
FRONTEND_URL=http://localhost:8000
