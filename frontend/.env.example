# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cloudinary cloud name — must match the backend's CLOUDINARY_CLOUD_NAME so
# next/image's remotePatterns allow-lists the right delivery host. Not a
# secret: this value is embedded in every Cloudinary image URL served to
# shoppers.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# App Configuration
NEXT_PUBLIC_APP_NAME=Ecommerce
NEXT_PUBLIC_APP_VERSION=1.0.0

# Features (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHAT=false

# Third-party Services (optional)
# NEXT_PUBLIC_STRIPE_KEY=pk_test_...
# NEXT_PUBLIC_GA_ID=UA-...
